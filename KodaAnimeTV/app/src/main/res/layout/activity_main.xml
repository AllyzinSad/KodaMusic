<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A12">

    <ImageView
        android:id="@+id/hero_banner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:src="@drawable/tv_banner"
        app:layout_constraintHeight_percent="0.60"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_hero_scrim"
        app:layout_constraintTop_toTopOf="@id/hero_banner"
        app:layout_constraintBottom_toBottomOf="@id/hero_banner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_gradient_hero"
        app:layout_constraintTop_toTopOf="@id/hero_banner"
        app:layout_constraintBottom_toBottomOf="@id/hero_banner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/hero_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="24dp"
        android:text="Koda Anime"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/top_navigation_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/nav_search"
            style="@style/TopNavButton"
            android:text="Pesquisa"
            android:nextFocusDown="@id/btn_play" />

        <Button
            android:id="@+id/nav_favorites"
            style="@style/TopNavButton"
            android:layout_marginStart="8dp"
            android:text="Favoritos"
            android:nextFocusDown="@id/btn_play" />

        <Button
            android:id="@+id/nav_history"
            style="@style/TopNavButton"
            android:layout_marginStart="8dp"
            android:text="Histórico"
            android:nextFocusDown="@id/btn_play" />

        <Button
            android:id="@+id/nav_settings"
            style="@style/TopNavButton"
            android:layout_marginStart="8dp"
            android:text="Configurações"
            android:nextFocusDown="@id/btn_info" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hero_details_container"
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="56dp"
        android:layout_marginBottom="32dp"
        android:elevation="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/hero_banner">

        <TextView
            android:id="@+id/hero_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Koda Anime"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/hero_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            android:textColor="#CCCCCC"
            android:maxLines="3"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <Button
                android:id="@+id/btn_play"
                style="@style/HeroButton"
                android:text="Assistir"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_primary"
                android:nextFocusRight="@id/btn_info"
                android:nextFocusDown="@id/rv_catalog_row"
                android:nextFocusUp="@id/nav_search"
                android:layout_height="44dp" />

            <Button
                android:id="@+id/btn_info"
                style="@style/HeroButton"
                android:text="Mais Informações"
                android:layout_marginStart="12dp"
                android:nextFocusLeft="@id/btn_play"
                android:nextFocusDown="@id/rv_catalog_row"
                android:nextFocusUp="@id/nav_settings"
                android:layout_height="44dp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/hero_banner"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/catalog_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="56dp"
                android:paddingEnd="32dp"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:text="Carregando catálogo…" />

            <Button
                android:id="@+id/btn_retry"
                style="@style/HeroButton"
                android:layout_marginStart="56dp"
                android:text="Tentar novamente"
                android:visibility="gone" />

            <TextView
                android:id="@+id/catalog_row_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="56dp"
                android:layout_marginTop="10dp"
                android:text="Catálogo KodaAnime"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_catalog_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="56dp"
                android:paddingEnd="32dp"
                android:paddingTop="12dp"
                android:paddingBottom="16dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:focusable="false"
                android:descendantFocusability="afterDescendants"
                android:nextFocusUp="@id/btn_play"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/recent_row_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="56dp"
                android:text="Lançados recentemente"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recent_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="56dp"
                android:paddingEnd="32dp"
                android:paddingTop="12dp"
                android:paddingBottom="24dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:focusable="false"
                android:descendantFocusability="afterDescendants"
                android:scrollbars="none" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
