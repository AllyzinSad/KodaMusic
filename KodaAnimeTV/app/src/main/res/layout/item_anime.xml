<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp" android:layout_height="wrap_content" android:layout_marginEnd="16dp"
    android:focusable="true" android:clickable="true" android:descendantFocusability="blocksDescendants"
    android:clipChildren="false" android:clipToPadding="false">
    <androidx.cardview.widget.CardView android:id="@+id/poster_card"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,2:3"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="#202027"
        app:cardPreventCornerOverlap="false" android:foreground="@drawable/bg_card_focus" android:duplicateParentState="true">
        <ImageView android:id="@+id/anime_poster" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/anime_audio" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|end" android:layout_margin="8dp" android:background="@drawable/bg_audio_pill"
            android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold"/>
    </androidx.cardview.widget.CardView>
    <TextView android:id="@+id/anime_title" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:paddingBottom="4dp" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end" app:layout_constraintTop_toBottomOf="@id/poster_card"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
