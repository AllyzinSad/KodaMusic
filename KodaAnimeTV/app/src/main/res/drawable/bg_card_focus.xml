<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#16FFFFFF" />
                    <stroke android:width="4dp" android:color="#50FF7849" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
                <shape>
                    <solid android:color="#00000000" />
                    <stroke android:width="2dp" android:color="#FFFF7849" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#0CFFFFFF" />
                    <stroke android:width="4dp" android:color="#40FF7849" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
                <shape>
                    <solid android:color="#00000000" />
                    <stroke android:width="2dp" android:color="#FFFF7849" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape>
            <solid android:color="#00000000" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
