<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.VIBRATE" tools:node="remove" />
    <application android:banner="@drawable/koda_mark" android:theme="@style/Theme.Koda">
        <activity android:name=".MainActivity" tools:node="remove" />
        <service android:name=".download.DownloadService" tools:node="remove" />
        <receiver android:name=".widget.MediaWidgetSquare" tools:node="remove" />
        <receiver android:name=".widget.MediaWidgetWide" tools:node="remove" />
        <receiver android:name=".widget.MediaWidgetActions" tools:node="remove" />
        <activity android:name=".tv.TvActivity" android:exported="true"
            android:screenOrientation="landscape" android:theme="@style/Theme.Koda">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
